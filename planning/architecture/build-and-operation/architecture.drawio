<mxfile host="app.diagrams.net"><diagram name="build-and-operation" id="d1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="964" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Build and Operation: current design&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="Repo → CI/CD with OIDC → one image per Lambda → Terraform per environment → logs, alarms, budgets. Shared by all owners (Ryan Fusco coordinates). Most items are Proposed until every owner accepts." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1500" height="22" as="geometry"/></mxCell><mxCell id="grepo" value="Repository (OPS-007)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="230" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;One repo&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;services/ · libs/ · infra/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="220" height="64" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;pull request → main&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#4B5563;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="220" height="64" as="geometry"/></mxCell><mxCell id="gci" value="GitHub Actions (OPS-005)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="300" height="230" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;ci.yml · every PR&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;lint · unit tests · terraform fmt / validate / plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="220" height="64" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;deploy.yml · push to main&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;unit tests → build → push → apply dev · prod by hand&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="220" height="64" as="geometry"/></mxCell><mxCell id="oidc" value="&lt;b&gt;IAM via OIDC&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;used by ci.yml and deploy.yml · deploy role + read-only plan role · no AWS keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="100" width="260" height="70" as="geometry"/></mxCell><mxCell id="ecr" value="&lt;b&gt;ECR · one repo per image&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;api · scraper · renderer · parser · matcher · notifier · dispatcher (OPS-003, OPS-004)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="740" y="197" width="260" height="70" as="geometry"/></mxCell><mxCell id="gtf" value="Terraform (infra/)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="70" width="580" height="330" as="geometry"/></mxCell><mxCell id="boot" value="&lt;b&gt;bootstrap (once, by hand)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;state bucket + native lockfile (OPS-001) · OIDC provider · CI roles · ECR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1090" y="110" width="520" height="64" as="geometry"/></mxCell><mxCell id="mods" value="&lt;b&gt;modules&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;data · ingestion · resumes · app · ops (which area owns which: SYS-Q03)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1090" y="200" width="520" height="64" as="geometry"/></mxCell><mxCell id="envs" value="&lt;b&gt;envs/dev · envs/prod&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;us-east-1 (OPS-006) · tfvars: cost caps (OPS-002, OPS-010), $50 budget (OPS-009), Bedrock model per task (OPS-006)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1090" y="290" width="520" height="80" as="geometry"/></mxCell><mxCell id="manual" value="&lt;b&gt;Manual steps (outside Terraform)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;verify SES recipients (OPS-008) · enable Bedrock model access (OPS-006) · seed the catalog JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#4B5563;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="300" height="84" as="geometry"/></mxCell><mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;CloudFront signing key · api + notifier only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="500" width="260" height="64" as="geometry"/></mxCell><mxCell id="lambdas" value="&lt;b&gt;All Lambdas (every area)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;own image + own IAM role · config from environment variables (OPS-I01, OPS-I03)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="500" width="260" height="84" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;data module (OPS-I02)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;DynamoDB table (design: database area) · S3 uploads/, resume/ (never expires), static site&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1090" y="500" width="320" height="84" as="geometry"/></mxCell><mxCell id="cw" value="&lt;b&gt;CloudWatch (OPS-I04)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;JSON logs · EMF metrics · dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="680" width="260" height="64" as="geometry"/></mxCell><mxCell id="alarms" value="&lt;b&gt;Alarms&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;DLQ &gt; 0 · scrape errors · API 5xx · SES bounces · 80% of the hourly and daily caps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1090" y="680" width="320" height="70" as="geometry"/></mxCell><mxCell id="sns" value="&lt;b&gt;SNS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;alarm emails to the team&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1480" y="680" width="180" height="64" as="geometry"/></mxCell><mxCell id="budget" value="&lt;b&gt;AWS Budgets · $50/month (OPS-009)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;alerts at 50 / 80 / 100% and on forecast&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1090" y="800" width="320" height="64" as="geometry"/></mxCell><mxCell id="e3" value="PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="ci"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dev" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="assume role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="oidc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="push images" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="deploy" target="ecr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="terraform apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="deploy" target="envs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecr" target="lambdas"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="deploys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="envs" target="lambdas"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="envs" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="read (api, notifier)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambdas" target="secrets"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="logs + metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lambdas" target="cw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cw" target="alarms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="alarms" target="sns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="budget" target="sns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; · Solid border: initial architecture or Accepted decision · &lt;i&gt;Dashed border&lt;/i&gt;: Proposed or pending · Grey: belongs to another area · IDs point to the decision or question in &lt;code&gt;architecture.md&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>