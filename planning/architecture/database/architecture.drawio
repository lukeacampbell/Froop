<mxfile host="app.diagrams.net"><diagram name="database" id="d1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="904" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Database: current design&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="One shared DynamoDB table per environment. Each area writes its own item types, and experience items are reached only through the experience_bank package. Shared by all owners (Ryan Fusco coordinates)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1500" height="22" as="geometry"/></mxCell><mxCell id="tbl" value="DynamoDB · single table (DB-I01) · on-demand capacity recommended (DB-Q04)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="780" height="720" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;PK USER#{sub}&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;PROFILE · SETTINGS (web-app-and-api)&lt;br&gt;DOC#… experience items: header, sections, entries, bullets, skills, pointer (experience-bank, DB-I02)&lt;br&gt;SUB#{sourceId} (writer: DB-Q03)&lt;br&gt;MATCH#{postingKey}: match + posting copy (DB-Q05), digest mark (DEL-011), delivery state (DB-I03), appliedAt (DB-Q06)&lt;br&gt;COST#{hour} per-user counter (DB-Q07)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="720" height="130" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;PK SOURCE#{id} · SK META&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;catalog and private sources (job-discovery-and-matching; writer of private sources: DB-Q03)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="270" width="720" height="64" as="geometry"/></mxCell><mxCell id="post" value="&lt;b&gt;PK POSTING#{postingKey} · SK META&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;added only if new (conditional put) · expires 30 days after last seen (TTL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="360" width="720" height="64" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b&gt;PK COST#{hour} · COST#{day} · SK META&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;platform totals for the hourly ($5) and daily ($1.50) caps (OPS-002, OPS-010, DB-Q07)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="450" y="450" width="720" height="64" as="geometry"/></mxCell><mxCell id="idx" value="&lt;b&gt;Indexes&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;GSI1: a source&#x27;s subscribers, and all catalog sources&lt;br&gt;GSI2: matches waiting for a digest (mark set by the Matcher, DEL-011)&lt;br&gt;LSI1: a user&#x27;s matches by date (must be created with the table; DB-Q02)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="550" width="720" height="100" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Access patterns&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;DB-AP01 to DB-AP14 in architecture.md: every key and index above serves at least one&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="680" width="720" height="64" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;web-app-and-api&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;profile, settings, subscriptions, applied flag · lists matches (LSI1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="70" as="geometry"/></mxCell><mxCell id="eb" value="&lt;b&gt;experience-bank&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;only reader and writer of DOC# items (EB-010) · cost caps (EB-004)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="320" height="70" as="geometry"/></mxCell><mxCell id="dl" value="&lt;b&gt;delivery&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;writes match delivery state · finds digests through GSI2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="320" height="70" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;build-and-operation&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;provisions the table in each environment (OPS-I02)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="320" height="70" as="geometry"/></mxCell><mxCell id="jdm" value="&lt;b&gt;job-discovery-and-matching&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;postings, sources, matches, digest mark, cost counters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="320" height="70" as="geometry"/></mxCell><mxCell id="e3" value="own items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="DOC#…" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="eb" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="add cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eb" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="query GSI2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="dl" target="idx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="provisions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="idx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="MATCH# + digest mark" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jdm" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jdm" target="src"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="conditional put" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jdm" target="post"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="add cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jdm" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; · Solid border: initial architecture or Accepted decision · &lt;i&gt;Dashed border&lt;/i&gt;: Proposed or pending · Grey: belongs to another area · IDs point to the decision or question in &lt;code&gt;architecture.md&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>