<mxfile host="app.diagrams.net"><diagram name="database" id="d1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="904" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Database: current design&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="One shared DynamoDB table per environment. Each area writes its own item types, and experience items are reached only through the experience_bank package. Shared by all owners (Ryan Fusco coordinates)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1500" height="22" as="geometry"/></mxCell><mxCell id="tbl" value="DynamoDB · single table (DB-I01) · on-demand capacity recommended (DB-Q04)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="780" height="720" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;PK USER#{sub}&lt;/b&gt;&lt;br&gt;PROFILE · SETTINGS · DOC# experience bank&lt;br&gt;SUB# (API); MATCH# snapshot + delivery state&lt;br&gt;WORK# durable ranking/render handoff + fencing&lt;br&gt;COST#HOUR and COSTRES# reservations (DB-I04 Proposed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="720" height="130" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;SOURCE#{id} / META&lt;/b&gt;&lt;br&gt;Greenhouse catalog/private configuration: API/seed&lt;br&gt;Poll state and leases: JDM (DB-I04 Proposed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="270" width="720" height="64" as="geometry"/></mxCell><mxCell id="post" value="&lt;b&gt;POSTING#gh.{board}.{postId}&lt;/b&gt;&lt;br&gt;Provider identity: JDM-008 Accepted&lt;br&gt;Availability / TTL schema: DB-I04 Proposed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="360" width="720" height="64" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b&gt;COST#HOUR / COST#DAY&lt;/b&gt;&lt;br&gt;Atomic three-counter reservations (DB-I04)&lt;br&gt;Dispatcher checkpoints: SYSTEM#JDM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="450" y="450" width="720" height="64" as="geometry"/></mxCell><mxCell id="idx" value="&lt;b&gt;Indexes (DB-I04 Proposed amendment)&lt;/b&gt;&lt;br&gt;GSI1: catalog, private sources, subscribers, board postings&lt;br&gt;GSI2: digest buckets DIGEST#{mode}#{send window} (DEL-020)&lt;br&gt;GSI3: matches by date; replaces LSI1 (DB-Q02)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="550" width="720" height="100" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Access patterns DB-AP01 to DB-AP20&lt;/b&gt;&lt;br&gt;Paginated scans recover due work and sources&lt;br&gt;Checkpointed passes; small-demo tradeoff (DB-I04)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="680" width="720" height="64" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;web-app-and-api&lt;/b&gt;&lt;br&gt;Config / subscriptions / applied flag&lt;br&gt;Matches feed: proposed GSI3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="70" as="geometry"/></mxCell><mxCell id="eb" value="&lt;b&gt;experience-bank&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;only reader and writer of DOC# items (EB-010) · budget reservations (EB-017)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="320" height="70" as="geometry"/></mxCell><mxCell id="dl" value="&lt;b&gt;delivery&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;writes match delivery state · finds digests through GSI2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="320" height="70" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;build-and-operation&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;provisions the table in each environment (OPS-I02)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="320" height="70" as="geometry"/></mxCell><mxCell id="jdm" value="&lt;b&gt;job-discovery-and-matching&lt;/b&gt;&lt;br&gt;Greenhouse postings, work, matches&lt;br&gt;Digest marks + budget reservations (DB-I04)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="320" height="70" as="geometry"/></mxCell><mxCell id="e3" value="own items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="DOC#…" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="eb" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="add cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eb" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="query GSI2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="dl" target="idx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="provisions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="idx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="MATCH# + digest mark" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jdm" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jdm" target="src"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="conditional put" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jdm" target="post"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="add cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=10;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="jdm" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; · Solid border: initial architecture or Accepted decision · &lt;i&gt;Dashed border&lt;/i&gt;: Proposed or pending · Grey: belongs to another area · IDs point to the decision or question in &lt;code&gt;architecture.md&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1300" hei