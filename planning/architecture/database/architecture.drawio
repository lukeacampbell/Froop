<mxfile host="app.diagrams.net"><diagram name="database" id="d1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="1206" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="&lt;b&gt;Database: current design&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="28" as="geometry"/></mxCell><mxCell id="n12" value="One shared DynamoDB table per environment. Each record lives in a folder (&lt;b&gt;PK&lt;/b&gt;) under a name (&lt;b&gt;SK&lt;/b&gt;). Row colors show which area writes the record. Indexes (right) are extra ways to look records up. Shared by all owners (Ryan Fusco coordinates). Everything here is &lt;i&gt;Proposed&lt;/i&gt; until all three owners accept, except Profile and Settings (DB-I05), which is Accepted." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1500" height="36" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Folders (partition keys) and the records in them&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="840" height="22" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;PK = USER#{sub}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;everything about one student, so most screens and jobs need a single query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#0F172A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="118" width="840" height="494" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;PROFILE · SETTINGS&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#2563EB&#x27;&gt;&lt;b&gt;[web-app-and-api]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;the student&#x27;s email, delivery mode (default daily), and title and location filters (default title filter: intern)&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I05)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="156" width="800" height="42" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;DOC#…&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#16A34A&#x27;&gt;&lt;b&gt;[experience-bank]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;experience bank: upload, header, sections, entries, bullets, skills, current-upload pointer. Read only through the experience_bank package&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I02, EB-010)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="206" width="800" height="42" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;SUB#{sourceId}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#2563EB&#x27;&gt;&lt;b&gt;[web-app-and-api]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;the student follows this board · in GSI1 as a subscriber&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="256" width="800" height="42" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;MATCH#{postingKey} · core&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#EA580C&#x27;&gt;&lt;b&gt;[job-discovery-and-matching]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;posting snapshot, ranking, generation, digest mark · in GSI2 (digest) and GSI3 (feed)&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04, DEL-011, DEL-020)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFEDD5;strokeColor=#EA580C;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="306" width="800" height="42" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;MATCH#{postingKey} · delivery fields&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#7C3AED&#x27;&gt;&lt;b&gt;[delivery]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;renderStatus, pdfKey, notifyStatus (sent at most once)&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I03, DEL-017, DEL-018)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7C3AED;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="356" width="800" height="42" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;MATCH#{postingKey} · appliedAt&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#2563EB&#x27;&gt;&lt;b&gt;[web-app-and-api]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;set when the student marks the match as applied&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-Q06)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="406" width="800" height="42" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;WORK#{workId}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#EA580C&#x27;&gt;&lt;b&gt;[job-discovery-and-matching]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;a durable ranking or render job, with a lease so retries are safe&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFEDD5;strokeColor=#EA580C;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="456" width="800" height="42" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;COST#HOUR#{UTC-hour}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#A16207&#x27;&gt;&lt;b&gt;[shared budget (parser + Matcher, JDM-I04)]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;this student&#x27;s Bedrock spend this hour ($1 cap)&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04, OPS-002)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF9C3;strokeColor=#A16207;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="506" width="800" height="42" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;COSTRES#{attemptId}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#A16207&#x27;&gt;&lt;b&gt;[shared budget (parser + Matcher, JDM-I04)]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;one budget reservation per Bedrock call&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04, EB-017)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF9C3;strokeColor=#A16207;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="556" width="800" height="42" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;PK = SOURCE#{sourceId}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;one Greenhouse board, either from the catalog or added privately by a student&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#0F172A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="840" height="94" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;META · configuration&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#0284C7&#x27;&gt;&lt;b&gt;[catalog seed / web-app-and-api]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;board token, catalog or private, owner · in GSI1&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E0F2FE;strokeColor=#0284C7;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="668" width="392" height="42" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;META · polling fields&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#EA580C&#x27;&gt;&lt;b&gt;[job-discovery-and-matching]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;next poll, lease, last success or error&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFEDD5;strokeColor=#EA580C;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="458" y="668" width="392" height="42" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;PK = POSTING#gh.{boardToken}.{jobPostId}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;one public job, shared by every student · key format accepted (JDM-008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#0F172A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="742" width="840" height="94" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;META&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#EA580C&#x27;&gt;&lt;b&gt;[job-discovery-and-matching]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;title, company, location, description, apply link, active flag · added only if new · in GSI1 by board · deleted 30 days after last seen (TTL)&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04, JDM-008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFEDD5;strokeColor=#EA580C;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="780" width="800" height="42" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;PK = COST#HOUR#{UTC-hour} · COST#DAY#{UTC-date}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;platform-wide Bedrock spend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#0F172A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="854" width="840" height="94" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;META&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#A16207&#x27;&gt;&lt;b&gt;[shared budget (parser + Matcher, JDM-I04)]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;platform totals for the $5/hour and $1.50/day caps · reserved atomically with the per-user counter&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04, OPS-010, DB-AP17)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF9C3;strokeColor=#A16207;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="892" width="800" height="42" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;PK = SYSTEM#JDM&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;internal bookkeeping&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#0F172A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="966" width="840" height="94" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;DISPATCH#{passType}&lt;/b&gt; &amp;nbsp;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#EA580C&#x27;&gt;&lt;b&gt;[job-discovery-and-matching]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;the dispatcher&#x27;s bookmark for its paginated scans, so a crash can resume&lt;/font&gt; &lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#64748B&#x27;&gt;(DB-I04, DB-AP18)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFEDD5;strokeColor=#EA580C;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="1004" width="800" height="42" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Indexes: other ways to look records up&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="610" height="22" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;GSI1 · one index, four lookups&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;&lt;code&gt;CATALOG&lt;/code&gt; → every catalog board (DB-AP06)&lt;br&gt;&lt;code&gt;USER#{sub}#SOURCES&lt;/code&gt; → a student&#x27;s private boards (DB-AP19)&lt;br&gt;&lt;code&gt;SOURCE#{id}#SUBSCRIBERS&lt;/code&gt; → who follows a board (DB-AP05)&lt;br&gt;&lt;code&gt;BOARD#{token}#POSTINGS&lt;/code&gt; → a board&#x27;s postings, to reconcile after a poll (DB-AP20)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0F2FE;strokeColor=#0284C7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="910" y="118" width="610" height="118" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;GSI2 · digest buckets&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;&lt;code&gt;DIGEST#hourly#{UTC-hour}&lt;/code&gt; or &lt;code&gt;DIGEST#daily#{UTC-date}&lt;/code&gt;, sorted by student&lt;br&gt;→ the matches waiting for this send (DB-AP10)&lt;br&gt;The Matcher sets the mark. The Notifier removes it after sending, or moves a not-yet-rendered match to the next send (DEL-020).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0F2FE;strokeColor=#0284C7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="910" y="250" width="610" height="104" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;GSI3 · the matches feed&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;&lt;code&gt;USER#{sub}#MATCHES&lt;/code&gt;, sorted by &lt;code&gt;createdAt&lt;/code&gt;&lt;br&gt;→ a student&#x27;s matches, newest first, for the dashboard (DB-AP08)&lt;br&gt;Replaces the RFC&#x27;s LSI1, and every owner agrees (DB-Q02). It may lag a brand-new match by a moment.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E0F2FE;strokeColor=#0284C7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="910" y="368" width="610" height="92" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Rules every writer follows&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="910" y="484" width="610" height="22" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;• &lt;b&gt;No duplicates:&lt;/b&gt; postings and matches are created with conditional writes, so a retry can&#x27;t make a second copy.&lt;br&gt;• &lt;b&gt;Experience bank:&lt;/b&gt; only the experience_bank package reads DOC# items (EB-010).&lt;br&gt;• &lt;b&gt;Postings:&lt;/b&gt; &#x27;active&#x27; is a flag on the posting. TTL only cleans up old ones.&lt;br&gt;• &lt;b&gt;Item size:&lt;/b&gt; under 300 KiB (DynamoDB&#x27;s limit is 400 KB). Snapshots are capped at 128 KiB.&lt;br&gt;• &lt;b&gt;Scans:&lt;/b&gt; due sources and work are found by paginated scans (DB-AP15, DB-AP16). That&#x27;s fine for the demo, but it won&#x27;t scale.&lt;br&gt;• &lt;b&gt;Capacity:&lt;/b&gt; on-demand (DB-001).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="910" y="512" width="610" height="150" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Open questions&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="910" y="680" width="610" height="22" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Waiting on&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#1F2937&#x27;&gt;• &lt;b&gt;Graham Cohick and Luke Campbell:&lt;/b&gt; accept DB-I01, DB-I02, DB-I04, and DB-001 (Ryan Fusco has)&lt;br&gt;• &lt;b&gt;Luke Campbell:&lt;/b&gt; accept DB-I03 (Graham Cohick and Ryan Fusco have)&lt;br&gt;• &lt;b&gt;JDM-I05:&lt;/b&gt; regeneration command fields, pending Graham Cohick&lt;br&gt;• &lt;b&gt;Settled:&lt;/b&gt; DB-I05 (Profile and Settings) is Accepted. DB-Q06 (appliedAt) is resolved.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#334155;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="910" y="708" width="610" height="112" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;Legend&lt;/b&gt; · Row color = the area that writes the record:" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="420" height="24" as="geometry"/></mxCell><mxCell id="n42" value="&lt;font style=&#x27;font-size:10px&#x27;&gt;web-app-and-api&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1118" width="150" height="26" as="geometry"/></mxCell><mxCell id="n43" value="&lt;font style=&#x27;font-size:10px&#x27;&gt;experience-bank&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="1118" width="150" height="26" as="geometry"/></mxCell><mxCell id="n44" value="&lt;font style=&#x27;font-size:10px&#x27;&gt;job-discovery-and-matching&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="1118" width="150" height="26" as="geometry"/></mxCell><mxCell id="n45" value="&lt;font style=&#x27;font-size:10px&#x27;&gt;delivery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="1118" width="150" height="26" as="geometry"/></mxCell><mxCell id="n46" value="&lt;font style=&#x27;font-size:10px&#x27;&gt;shared budget (parser + Matcher, JDM-I04)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=10;" vertex="1" parent="1"><mxGeometry x="660" y="1118" width="270" height="26" as="geometry"/></mxCell><mxCell id="n47" value="&lt;font style=&#x27;font-size:10px&#x27;&gt;catalog seed / web-app-and-api&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="1118" width="150" height="26" as="geometry"/></mxCell><mxCell id="n48" value="Solid border: initial architecture or Accepted decision · &lt;i&gt;Dashed border&lt;/i&gt;: Proposed or pending (in this shared area, every folder and index is still Proposed) · IDs point to the decision or question in &lt;code&gt;architecture.md&lt;/code&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="1152" width="1500" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>