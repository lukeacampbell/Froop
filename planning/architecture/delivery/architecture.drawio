<mxfile host="app.diagrams.net"><diagram name="delivery" id="d1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="944" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Delivery: current design&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="Render message → fit one page from verbatim LaTeX source → PDF kept forever → instant email with PDF, or digest with links. Owner: Ryan Fusco." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1500" height="22" as="geometry"/></mxCell><mxCell id="matcher" value="&lt;b&gt;Matcher&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;job-discovery-and-matching&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="sqs" value="&lt;b&gt;SQS render&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;queue + DLQ · render message (DEL-010)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FCE7F3;strokeColor=#DB2777;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="200" height="64" as="geometry"/></mxCell><mxCell id="g" value="Renderer (Lambda · renderer image)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="60" width="440" height="400" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;1 · Check bank version&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;docId not current → skipped, no email (DEL-003)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="380" height="64" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;2 · Choose sections&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;required: header, Education, Experience · likely: Projects, Skills · possible: Awards, Certifications, Publications (DEL-015, DEL-016)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="190" width="380" height="70" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;3 · Fit to one page&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;estimate → render → prune (DEL-005) · fill by score with decay (DEL-013)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="285" width="380" height="64" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;4 · Compile safely&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;Froop template, allowed macros only, no shell escape (DEL-001, DEL-002)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="610" y="375" width="380" height="64" as="geometry"/></mxCell><mxCell id="pkg" value="&lt;b&gt;experience_bank package (EB-I03)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;header · ranked items (source + text) · supported templates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1100" y="190" width="280" height="70" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;S3 · resume/&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;{sub}/{postingKey}/{docId}.pdf (DEL-009) · never expires (DEL-007)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1100" y="375" width="280" height="70" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b&gt;DynamoDB · match state (DB-I03)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;renderStatus · pdfKey · pdfHistory · digest mark · appliedAt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1100" y="520" width="280" height="70" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API (web-app-and-api)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;dashboard signed links (DEL-I01) · regenerate · mark applied (DEL-Q12)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1440" y="375" width="260" height="70" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b&gt;EventBridge digest schedule&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;hourly · daily&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8