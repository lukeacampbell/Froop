<mxfile host="app.diagrams.net"><diagram name="experience-bank" id="d1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="884" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Experience Bank: current design&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="Upload one .tex resume → parse without an LLM → store verbatim items → other areas read only through the package. Owner: Ryan Fusco." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1500" height="22" as="geometry"/></mxCell><mxCell id="student" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#4B5563;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="64" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API (Lambda)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;web-app-and-api · POST /uploads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="200" height="64" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;S3 · uploads/&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;{sub}/{docId}.tex · presigned PUT · .tex only (EB-001)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="240" height="64" as="geometry"/></mxCell><mxCell id="g" value="Bank parser (Lambda)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="440" height="400" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;1 · Read as text, never compile&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;reject \write18, \input, \openout, … (EB-009)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="380" height="64" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;2 · Header block and sections&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;heading dictionary · Jake&#x27;s Resume macros (EB-003, EB-014, EB-015)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="200" width="380" height="64" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;3 · Entries, bullets, skills&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;section categories · skills grouped by category (EB-016)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="970" y="290" width="380" height="64" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;4 · Verbatim check, then store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;every item is an exact span · source + text (EB-012)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="380" width="380" height="64" as="geometry"/></mxCell><mxCell id="bedrock" value="&lt;b&gt;Bedrock&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;leftover sections only · smallest model (OPS-006) · if a cap is hit, sections stay unclassified (EB-013)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1480" y="190" width="260" height="84" as="geometry"/></mxCell><mxCell id="caps" value="&lt;b&gt;Cost caps&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;$1/user/h · $5/h · $1.50/day (EB-004, OPS-002, OPS-010)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1480" y="70" width="260" height="64" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b&gt;DynamoDB · experience items (DB-I02)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;USER#{sub} · DOC#… header, sections, entries, bullets, skills · current-upload pointer (EB-008)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D1FAE5;strokeColor=#047857;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="540" width="380" height="70" as="geometry"/></mxCell><mxCell id="pkg" value="&lt;b&gt;experience_bank package (EB-I03)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;get_bank · get_items · delete_bank · upload_status · resolve (EB-007) · supported_templates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fi