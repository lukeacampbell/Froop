<mxfile host="app.diagrams.net"><diagram name="web-app-and-api" id="d1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="744" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Web App and API: current design&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="The design as it stands on 2026-11-23: the initial architecture, Accepted decisions WEB-001 to WEB-013, and the other areas' decisions that reach this one. Owner: Graham Cohick. Dashed items are still open." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1500" height="22" as="geometry"/></mxCell><mxCell id="student" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#4B5563;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="180" height="64" as="geometry"/></mxCell><mxCell id="cognito" value="&lt;b&gt;Cognito&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;user pool · hosted UI · code flow + PKCE (WEB-002) · sign-up switch (WEB-004)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="220" height="64" as="geometry"/></mxCell><mxCell id="apigw" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;HTTP API · JWT authorizer · CORS (WEB-010)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="220" height="64" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API (Lambda)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;FastAPI + Mangum · endpoints: WEB-001 · user ID from the token only (WEB-005)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="230" width="240" height="70" as="geometry"/></mxCell><mxCell id="cf" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;dashboard + signed resume links, 15 min (WEB-007)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="220" height="64" as="geometry"/></mxCell><mxCell id="site" value="&lt;b&gt;S3 static site&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;React dashboard · 5 screens (WEB-009) · hash routes (WEB-010)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="220" height="64" as="geometry"/></mxCell><mxCell id="secrets" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#374151&#x27;&gt;CloudFront signing key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF9C3;strokeColor=#A16207;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="80" width="200" height="64" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font